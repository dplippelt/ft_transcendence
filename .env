# Delegate builds for better performance when using docker compose
COMPOSE_BAKE=true

# FRONTEND
CONTAINER_FE=frontend
FE_PORT=5173

# VOLUMES
VOLUME_FE_HOST=./services/frontend/app
VOLUME_FE_CONTAINER=/app

POSTGRES_DB=game_db
POSTGRES_USER=game_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://game_user:change-me@db:5432/game_db

SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
